# ---- ArvoARC veri katmani (arc.arvo-os.com) ----
# Zorunlu. Eksikse build acik bir hatayla durur.
ARC_SUPABASE_URL=https://<proje-ref>.supabase.co
ARC_SUPABASE_PUBLISHABLE_KEY=
# ARC_ORGANIZATION_ID artık YOK: vitrin çok mağazalı, kurum adresten
# çözülüyor (lib/konak → vitrinKurumu). Sabit bir kimlik, ortak
# dağıtımda her mağazaya ArvoCulture'ın temasını giydirirdi.

# ---- Müşteri hesapları (tarayıcı tarafı kimlik doğrulama) ----
# Bu iki değer tarayıcıya açılır; güvenlik RLS politikalarından gelir.
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Site ----
# Kanonik adres. sitemap, robots, canonical ve OG etiketleri bunu kullanir.
NEXT_PUBLIC_SITE_URL=https://arvoculture.com

# ---- PayTR (odeme etkinlestirildiginde) ----
# ASLA repoya commit etmeyin. Yalnizca Vercel ortam degiskenlerinde tutun.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# --- Vitrin hangi mağazanın? ---
# TANIMLIYSA tek mağaza kipi: adres buradan gelir, istek başlığına hiç
# bakılmaz. Önemi önbellek: headers() çağırmak Next'te rotayı
# dinamikleştiriyor ve ürün sayfasının altmış saniyelik rota
# önbelleğini düşürüyor (canlıda ölçüldü: x-vercel-cache HIT → MISS).
#
# BOŞ BIRAKILIRSA çok mağaza kipi: adres istekten okunur ve aynı
# dağıtım bütün mağazalara hizmet eder. Bedeli, adresi okuyan
# sayfaların dinamikleşmesi.
VITRIN_KONAGI=arvoculture.com
